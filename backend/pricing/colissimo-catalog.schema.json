{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "recipient": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Recipient",
          "type": "string"
        },
        "line1": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Line1",
          "type": "string"
        },
        "line2": {
          "default": "",
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Line2",
          "type": "string"
        },
        "postal_code": {
          "default": "",
          "maxLength": 32,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Postal Code",
          "type": "string"
        },
        "city": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "City",
          "type": "string"
        },
        "country": {
          "pattern": "^[A-Z]{2}$",
          "title": "Country",
          "type": "string"
        },
        "phone": {
          "default": "",
          "maxLength": 32,
          "pattern": "^[+0-9 ().-]*$",
          "title": "Phone",
          "type": "string"
        },
        "instructions": {
          "default": "",
          "maxLength": 1000,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Instructions",
          "type": "string"
        }
      },
      "required": [
        "recipient",
        "line1",
        "city",
        "country"
      ],
      "title": "Address",
      "type": "object"
    },
    "Charge": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Localized"
        },
        "amount_minor": {
          "anyOf": [
            {
              "maximum": 100000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount Minor"
        },
        "tax": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tax"
