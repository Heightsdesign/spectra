        "source_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Reference"
        },
        "cost_basis_reference": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
