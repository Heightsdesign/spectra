        "included_in_transport": {
          "default": false,
          "title": "Included In Transport",
          "type": "boolean"
        },
        "premium": {
          "anyOf": [
            {
              "$ref": "#/$defs/Charge"
            },
            {
              "type": "null"
            }
          ],
          "default": null
